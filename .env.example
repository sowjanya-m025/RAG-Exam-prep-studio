# Copy to .env and fill in. NEVER commit .env
#
# ---- OPTION 1 (FREE, recommended): Google Gemini ----
# Get a free key at https://aistudio.google.com/app/apikey (sign in with Google, "Create API key")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---- OPTION 2 (FREE, offline): Ollama on your own laptop ----
# Install from ollama.com, then run:  ollama pull llama3.1:8b
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b

# ---- OPTION 3 (paid): Anthropic Claude ----
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5

# ---- OPTION 4: no AI at all, fake answers for a UI demo ----
# LLM_PROVIDER=mock

EMBEDDING_BACKEND=auto          # auto | sbert | tfidf
